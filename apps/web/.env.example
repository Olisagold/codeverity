# Template for apps/web environment variables. Copy to .env.local and adjust.
#   cp .env.example .env.local

# Base URL of the Codeverity API (apps/api). No trailing slash.
# Local:      http://localhost:8000
# Production: https://api.codeverity.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this Next.js app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
