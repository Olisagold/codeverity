# ── General ───────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development

# ── apps/web (Next.js frontend) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── apps/api (FastAPI backend) ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
API_CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeverity
REDIS_URL=redis://localhost:6379/0

# ── Auth / third-party ────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# Where the API sends the browser back to after a Google/GitHub login (the
# frontend's own origin, not the API's).
FRONTEND_URL=http://localhost:3000

# Sendlib (sendlib.samueltuoyo.com) sends the signup OTP email. From is
# optional if only one Gmail account is connected to the Sendlib account.
SENDLIB_API_KEY=
SENDLIB_FROM_EMAIL=

# Public base URL for email images (social icons). Email clients can't load
# localhost, so this points at GitHub until the frontend is deployed.
EMAIL_ASSETS_URL=https://raw.githubusercontent.com/Olisagold/codeverity/main/apps/web/public/icons

INSTAGRAM_URL=https://instagram.com
X_URL=https://x.com
GITHUB_URL=https://github.com
LINKEDIN_URL=https://linkedin.com

# ── Model providers ───────────────────────────────────────
# Assessors run in parallel; a provider with no key is skipped. Claude reviews
# their output and writes the final result.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=
# Tried in order. Rate limited or unavailable models fall through to the next.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
REVIEWER_EFFORT=medium

ASSESSOR_EFFORT=low
ASSESSOR_MAX_TOKENS=4000
MODEL_TIMEOUT_SECONDS=90

MIN_MODEL_RESULTS=2

# ── codeverity-react (legacy/standalone React app) ────────
VITE_API_URL=http://localhost:8000
