# ── General ───────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development

# ── apps/web (Next.js frontend) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── apps/api (FastAPI backend) ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
API_CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeverity
REDIS_URL=redis://localhost:6379/0

# ── Auth / third-party ────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# Where the API sends the browser back to after a Google/GitHub login (the
# frontend's own origin, not the API's).
FRONTEND_URL=http://localhost:3000

# Sendlib (sendlib.samueltuoyo.com) sends the signup OTP email. From is
# optional if only one Gmail account is connected to the Sendlib account.
SENDLIB_API_KEY=
SENDLIB_FROM_EMAIL=

# Must be a public URL, email clients can't load localhost. Once the frontend
# is deployed, point this at ${FRONTEND_URL}/icons/logo.png.
EMAIL_LOGO_URL=https://raw.githubusercontent.com/Olisagold/codeverity/main/apps/web/public/icons/logo.png

# ── codeverity-react (legacy/standalone React app) ────────
VITE_API_URL=http://localhost:8000
