# ── General ───────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development

# ── apps/web (Next.js frontend) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── apps/api (FastAPI backend) ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
API_CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeverity
REDIS_URL=redis://localhost:6379/0

# ── Auth / third-party ────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Where the API sends the browser back to after a Google login (the frontend's
# own origin, not the API's).
FRONTEND_URL=http://localhost:3000

# ── codeverity-react (legacy/standalone React app) ────────
VITE_API_URL=http://localhost:8000
